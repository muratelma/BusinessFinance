{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/charts/**",
              "components/core/**",
              "components/feedback/**",
              "components/forms/**",
              "components/lists/**",
              "components/money/**",
              "components/navigation/**",
              "ui_kits/mobile/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Roboto|Material Symbols Outlined))/i]",
        "message": "Font not provided by the design system. Available: Roboto, Material Symbols Outlined."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppBottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|children|onClose|maxHeight|style|key|ref|className|style|children)$/]",
        "message": "<AppBottomSheet> doesn't accept that prop. Declared props: title, subtitle, children, onClose, maxHeight, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|padding|selected|background|onClick|style|key|ref|className|style|children)$/]",
        "message": "<AppCard> doesn't accept that prop. Declared props: children, padding, selected, background, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppConfirmDialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|highlight|message|confirmLabel|cancelLabel|destructive|onConfirm|onCancel|style|key|ref|className|style|children)$/]",
        "message": "<AppConfirmDialog> doesn't accept that prop. Declared props: icon, highlight, message, confirmLabel, cancelLabel, destructive, onConfirm, onCancel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppContentWidth'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<AppContentWidth> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppDateField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|onChange|helperText|errorText|labelBackdrop|style|key|ref|className|style|children)$/]",
        "message": "<AppDateField> doesn't accept that prop. Declared props: label, value, onChange, helperText, errorText, labelBackdrop, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppDonutSlice'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|color|formattedValue|key|ref|className|style|children)$/]",
        "message": "<AppDonutSlice> doesn't accept that prop. Declared props: label, value, color, formattedValue."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppEmptyView'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|message|action|style|key|ref|className|style|children)$/]",
        "message": "<AppEmptyView> doesn't accept that prop. Declared props: icon, title, message, action, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppErrorView'] > JSXAttribute > JSXIdentifier[name!=/^(?:message|onRetry|style|key|ref|className|style|children)$/]",
        "message": "<AppErrorView> doesn't accept that prop. Declared props: message, onRetry, style."
