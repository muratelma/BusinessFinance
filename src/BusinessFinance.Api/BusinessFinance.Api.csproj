<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>business-finance-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sözleşme sözlüklerinin enum'la birlikte büyüdüğünü doğrulayan kapı
         onları okumak zorunda. Alternatifi public yapmaktı; kablo değeri
         eşlemesi API'nin iç detayıdır ve dışarıya sözleşme gibi görünmemeli. -->
    <InternalsVisibleTo Include="BusinessFinance.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BusinessFinance.Application\BusinessFinance.Application.csproj" />
    <ProjectReference Include="..\BusinessFinance.Infrastructure\BusinessFinance.Infrastructure.csproj" />
  </ItemGroup>

</Project>
