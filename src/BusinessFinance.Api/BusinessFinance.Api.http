@BusinessFinance.Api_HostAddress = https://localhost:7092
@accessToken = replace-with-login-response-access-token
@refreshToken = replace-with-login-response-refresh-token

GET {{BusinessFinance.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

POST {{BusinessFinance.Api_HostAddress}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "synthetic.user@example.com",
  "password": "Synthetic-Password-123!"
}

###

POST {{BusinessFinance.Api_HostAddress}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "synthetic.user@example.com",
  "password": "Synthetic-Password-123!"
}

###

POST {{BusinessFinance.Api_HostAddress}}/api/v1/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

###

POST {{BusinessFinance.Api_HostAddress}}/api/v1/accounts
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "name": "Synthetic Main Cash",
  "type": "cash",
  "currency": "TRY",
  "openingBalance": "1000.0000"
}

###

GET {{BusinessFinance.Api_HostAddress}}/api/v1/accounts?pageNumber=1&pageSize=20
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{BusinessFinance.Api_HostAddress}}/api/v1/transactions?pageNumber=1&pageSize=20&dateFrom=2026-01-01&dateTo=2026-01-31&type=expense&sort=date-desc
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{BusinessFinance.Api_HostAddress}}/api/v1/categories?type=expense&isActive=true
Authorization: Bearer {{accessToken}}
Accept: application/json

###

# Önce accountId ve categoryId değerlerini başarılı response'lardan doldur.
POST {{BusinessFinance.Api_HostAddress}}/api/v1/transactions
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "accountId": "00000000-0000-0000-0000-000000000001",
  "categoryId": "00000000-0000-0000-0000-000000000002",
  "amount": "125.5000",
  "currency": "TRY",
  "type": "expense",
  "transactionDate": "2026-08-09",
  "description": "Synthetic expense"
}

###

GET {{BusinessFinance.Api_HostAddress}}/api/v1/budgets?year=2026&month=8
Authorization: Bearer {{accessToken}}
Accept: application/json

###

GET {{BusinessFinance.Api_HostAddress}}/api/v1/reports/monthly?year=2026&month=8
Authorization: Bearer {{accessToken}}
Accept: application/json

###

POST {{BusinessFinance.Api_HostAddress}}/api/v1/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
