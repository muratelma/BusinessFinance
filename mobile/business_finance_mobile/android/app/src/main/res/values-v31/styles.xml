<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 ve sonrası açılışta kendi ekranını çizer ve ortasına
         kendiliğinden uygulama ikonunu koyar. İkon saydamdır: dokununca
         yalnız siyah ekran büyür, logo ilk kez giriş animasyonunda görünür
         (kullanıcı kararı, 8 Kasım 2026). Zemin animasyonun ilk karesiyle
         aynı. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/nomiva_splash</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
